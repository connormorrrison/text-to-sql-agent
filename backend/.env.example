# Copy to backend/.env for local development. Never commit the real .env.

# Postgres connection string. Matches the docker-compose.yml defaults locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/text_to_sql

# AWS region used for Bedrock and other AWS clients.
AWS_REGION=us-east-1

# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
